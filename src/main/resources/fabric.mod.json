{
	"schemaVersion": 1,
	"id": "autoclutch",
	"version": "${version}",
	"name": "AutoClutch",
	"description": "Automatic water bucket clutching with human-like timing. Helps you survive falls without dying!",
	"authors": [
		"HoneyBerries"
	],
	"contact": {
		"homepage": "https://honeyberries.net",
		"sources": "https://github.com/HoneyBerries/AutoClutch"
	},
	"license": "CC0-1.0",
	"icon": "assets/autoclutch/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.honeyberries.AutoClutch"
		],
		"client": [
			"net.honeyberries.AutoClutchClient"
		],
		"modmenu": [
          "net.honeyberries.config.AutoClutchModMenu"
		]
	},
	"mixins": [
		"autoclutch.mixins.json",
		{
			"config": "autoclutch.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	},

	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/TbkHCshxjS"
			},
			"update_checker": true
		}
	}

}