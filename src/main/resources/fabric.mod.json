{
	"schemaVersion": 1,
	"id": "autoclutch",
	"version": "${version}",
	"name": "AutoClutch",
	"description": "Automatic water bucket clutching with human-like timing. Helps you survive falls without dying!",
	"authors": [
		"HoneyBerries"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/autoclutch/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.honeyberries.AutoClutch"
		],
		"client": [
			"net.honeyberries.AutoClutchClient"
		]
	},
	"mixins": [
		"autoclutch.mixins.json",
		{
			"config": "autoclutch.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}